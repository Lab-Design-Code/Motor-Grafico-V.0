+def _pre_expandida(proyecto, pieza, formato, enc):
+    """Foto ya expandida por fuera del motor (Adobe Firefly), si calza con este encuadre.
+
+    pieza["expandidas"][formato] = {"archivo": ruta relativa a fotos/, "expansiones": {...}}.
+    Solo se usa si las expansiones son EXACTAMENTE las del encuadre vigente: la foto
+    expandida trae esas proporciones, y por eso el mismo `focal` del solver sigue
+    valiendo (como en Meta IPG-2027, generar_v3.py). Si el encuadre cambio, se ignora
+    y se vuelve a la expansion propia del motor.
+    """
+    pre = (pieza.get("expandidas") or {}).get(formato.nombre)
+    if not pre or not pre.get("archivo"):
+        return None
+    pedidas = {k: v for k, v in (enc.get("expansiones") or {}).items() if v}
+    hechas = {k: v for k, v in (pre.get("expansiones") or {}).items() if v}
+    if pedidas != hechas:
+        return None
+    ruta = proyecto.ruta_foto({"foto": pre["archivo"]})
+    return ruta if ruta and os.path.isfile(ruta) else None
+
